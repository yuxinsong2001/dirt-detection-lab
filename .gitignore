.ultralytics/
Ultralytics/
*.ttf

/ultralytics-repo/

# Machine-local generated dataset configurations and virtual environment
/cfg/local/
/.venv/

# Local tooling dependencies and temporary build artifacts
/.codex/
node_modules/
/tmp/
*.inspect.ndjson

# Report render previews and superseded report exports
/reports/archive/

# Keep the footer-updated presentation, PDF and speaker notes
# Older presentation exports are preserved under reports/archive/.

# Local teaching preferences, not project documentation
/NOTES.md

# Extracted third-party runtime copy (original tracked files stay tracked)
/yolov3-master/

# Downloaded external benchmark artifacts; provenance and extracted reports remain visible
/experiment-analysis/data/external/
