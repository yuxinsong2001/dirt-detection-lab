weights/

# --- 训练结果与日志 ---
# 忽略训练产生的 runs/exp1, runs/exp2 等
# Ignore new run outputs by default, but retain the selected lightweight
# evidence formats below. Reopening directories is required for Git negations.
/runs/**
!/runs/**/
!/runs/**/*.csv
!/runs/**/*.yaml
!/runs/**/*.png
!/runs/**/*.mp4
!/runs/**/README.md
/runs/**/weights/
yolov3-master/runs/
/wandb/
yolov3-master/wandb/
/comet/
yolov3-master/comet/

# --- 虚拟环境 ---
venv/
env/
.conda/

